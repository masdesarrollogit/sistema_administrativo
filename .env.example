APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ⚠ Seguridad de envíos en NO-producción (regla innegociable)
# En cualquier APP_ENV != production se aplican DOS protecciones globales:
#  1. Todos los mailers SMTP del sistema se redirigen a Mailpit (mailpit:1025)
#     ignorando cualquier MAIL_HOST=smtp.gmail.com u otro real configurado.
#  2. Todos los destinatarios se reescriben a MAIL_FORCE_TO.
# Esto evita envíos accidentales a destinatarios reales presentes en la BD.
MAIL_FORCE_TO=pruebas@webcurso.local
MAIL_FORCE_HOST=mailpit
MAIL_FORCE_PORT=1025
# MAIL_FORCE_TESTING=true  # opcional: forzar modo prueba aunque APP_ENV=production

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Moodle Integration
MOODLE_URL=
MOODLE_TOKEN=

# Docker / Sail
FORWARD_PHPMYADMIN_PORT=8080

# Candidatos - Recordatorios
CANDIDATOS_DIAS_ENTRE_RECORDATORIOS=3
CANDIDATOS_MAX_RECORDATORIOS=5
CANDIDATOS_HORA_RECORDATORIOS=09:00
CANDIDATOS_HORA_RESUMEN=13:00
CANDIDATOS_COPIA_EMAIL=
CANDIDATOS_EMAIL_ERRORES=
CANDIDATOS_RECORDATORIOS_ACTIVOS=true
CANDIDATOS_DESTINATARIOS_SALDO=

# Email mensual de saldo a participantes bonificados
BONIFICADOS_EMAIL_ACTIVO=true
BONIFICADOS_EMAIL_FRECUENCIA=monthly
BONIFICADOS_EMAIL_DIA=1
BONIFICADOS_EMAIL_HORA=10:00
BONIFICADOS_EMAIL_ERRORES=
# CC fijo añadido a cada email de saldo enviado (admin interno)
CANDIDATOS_BONIFICADOS_CC_ADMIN=webcurso@webcurso.es

# Datos de contacto (firma de emails)
CONTACTO_EMAIL=
CONTACTO_TELEFONO=
CONTACTO_WHATSAPP=
CONTACTO_WHATSAPP_DISPLAY=

# Seeders (credenciales de admin - obligatorias para ejecutar seeders)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Legacy DB (solo si necesitas importar datos del sistema antiguo)
LEGACY_DB_HOST=
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Zoho (Books / CRM)
# Obtener client_id y secret en https://api-console.zoho.eu
# redirect_uri debe coincidir con la URL registrada en la consola
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost/zoho/callback
ZOHO_REGION=eu
ZOHO_BOOKS_ORGANIZATION_ID=
# api_name del campo donde se guarda el CIF en cada factura/contacto Zoho Books (ej. cf_cif)
# Descúbrelo ejecutando: php artisan zoho:probe-contact
ZOHO_BOOKS_CIF_FIELD=cf_cif
ZOHO_BOOKS_PHONE_FIELD=phone
# Se rellena automáticamente tras completar OAuth desde /zoho/connect (no editar a mano)
#ZOHO_REFRESH_TOKEN=

# OCR local (Tier 3 del pipeline de Fichas/Encomienda PDF)
# Activa el OCR con Tesseract cuando el PDF no tiene AcroForm ni capa de texto.
# Requiere paquetes APT en el contenedor: tesseract-ocr, tesseract-ocr-spa
PDF_OCR_ENABLED=true
PDF_OCR_DPI=300
PDF_OCR_LANG=spa+eng
PDF_OCR_PSM=6
PDF_OCR_MAX_PAGES=3
PDF_OCR_MIN_CHARS=200
